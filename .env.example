# --- Base de données PostgreSQL ---
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@localhost:5432/solvemate

# --- LLM Gemini (clé gratuite : https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Surveillance de la boîte ---
POLL_INTERVAL_SECONDS=30

# --- Boîte de support (Gmail : IMAP activé + mot de passe d'application) ---
IMAP_HOST=imap.gmail.com
IMAP_USER=support.solvemate@gmail.com
IMAP_PASSWORD=

# --- Envoi des e-mails ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=support.solvemate@gmail.com
SMTP_PASSWORD=

# --- Opérateur humain qui reçoit les escalades ---
OPERATOR_EMAIL=operateur@example.com

# --- true : aucun e-mail envoyé, seulement affiché et enregistré dans reports/outbox.log ---
DRY_RUN=true

# --- Base vectorielle Qdrant (Docker) : interface web sur http://localhost:6333/dashboard ---
QDRANT_URL=http://localhost:6333
